# =============================================================
# Pixel Angler The Real — 환경 변수 예시 (값은 비워 둔다)
# 복사해서 아래 「둘 곳」에 .env 로 저장하고 키를 넣는다. .env 는 커밋하지 않는다.
#
# 둘 곳 — 읽는 쪽마다 다르다
#   · 클라이언트 (VITE_*)       → packages/client-pc/.env   (Vite 기준 폴더)
#   · 지도 래스터 도구 (CDSE_*)  → 저장소 루트 .env          (tools/fetch_region_raster.py 가 직접 읽는다)
#   · 서버                      → 서버 실행 폴더의 .env 또는 셸 환경 변수
#
# 키가 없으면 모든 연동이 만든 값(mock)으로 돈다 — 따로 켜고 끄는 스위치는 없다.
# ⚠ VITE_ 로 시작하는 값은 빌드한 번들에 그대로 들어간다(브라우저에서 보인다).
# =============================================================

# ─────────────────────────────────────────────
# 클라이언트 — packages/client-pc/.env
# ─────────────────────────────────────────────

# 공공데이터포털 (data.go.kr) — 기상청 단기예보 · 초단기실황, 국립해양조사원 바다낚시지수
# 발급: https://www.data.go.kr/
VITE_DATA_GO_KR_API_KEY=

# 해양수산부 국립해양측위정보원 — 해양기상 정보 (전국 76개 관측소)
# 발급: https://marineweather.nmpnt.go.kr/serviceReq/serviceOpenApiIntro.do
#   ※ 공공데이터포털(15033708)은 LINK 유형이라 위 포털에서 별도 발급받아야 하며
#     키 형식이 UUID다 (data.go.kr의 base64 키와 다름).
#   ※ HTTP 전용(포트 8001) — HTTPS 배포 시 프록시 필요
VITE_NMPNT_API_KEY=

# 농림수산식품교육문화정보원 — 수산물 경락 시세
# 발급: https://data.mafra.go.kr/
VITE_MAFRA_API_KEY=

# 통계청 KOSIS — 시도 · 어종별 어획량
# 발급: https://kosis.kr/openapi/
VITE_KOSIS_API_KEY=

# ─────────────────────────────────────────────
# 서버 (packages/server)
# ─────────────────────────────────────────────
SERVER_PORT=4000

# 멀티플레이 세션 파일을 둘 폴더 (없으면 실행 폴더의 .mp-sessions)
# MP_SESSION_DIR=

# 기상청 API허브 · 국립해양조사원 — 서버 날씨 프록시용 (지금은 뼈대 — 클라이언트가 부르지 않는다)
# 발급: https://apihub.kma.go.kr/ · https://www.khoa.go.kr/oceangrid/khoa/apiService.do
KMA_API_KEY=
KHOA_API_KEY=

# ─────────────────────────────────────────────
# 지도 래스터 도구 — 저장소 루트 .env
# Copernicus Data Space (CDSE) OAuth 클라이언트 — tools/fetch_region_raster.py 전용
# ─────────────────────────────────────────────
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# ─────────────────────────────────────────────
# 아래는 예전 예시에 있었지만 **지금 코드가 읽지 않는** 이름이다 (넣어도 효과 없음)
#   PUBLIC_DATA_API_KEY · WS_PORT · NODE_ENV · VITE_API_BASE_URL · VITE_WS_URL
#   VITE_USE_MOCK_DATA · USE_MOCK_DATA
# ─────────────────────────────────────────────
