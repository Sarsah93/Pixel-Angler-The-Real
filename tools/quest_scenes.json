[
 {
  "id": "M1-01",
  "idx": 16,
  "kind": "talk",
  "giver": "",
  "npc": "okseon",
  "onField": true,
  "entryOnField": true,
  "label": "정옥선 씨에게 고민을 털어놓는다",
  "place": "동명항 · 정옥선 좌판",
  "lines": [
   {
    "who": "정옥선",
    "text": "사진 속 기억을 찾으러 왔구나. 얼굴에 다 쓰여 있다."
   },
   {
    "who": "나",
    "text": "부모님이랑 왔던 자리예요. 이제 저 혼자인데, 어디서부터 시작해야 할지 모르겠어요."
   },
   {
    "who": "정옥선",
    "text": "울고 싶으면 울어도 된다. 다만 손은 놀리지 마라. 네가 할 수 있는 일부터 같이 해 보자."
   },
   {
    "who": "혼잣말",
    "text": "정옥선 씨가 먼저 손을 내밀어 주셨다. 여기서 시작하면 된다."
   }
  ],
  "hand": true
 },
 {
  "id": "M1-02",
  "idx": 3,
  "kind": "talk",
  "giver": "okseon",
  "npc": "okseon",
  "onField": true,
  "entryOnField": true,
  "label": "정옥선에게 얼음 상자를 내려놓았다고 보고한다",
  "place": "강원 속초",
  "lines": [
   {
    "who": "정옥선",
    "text": "품삯이다. 적어도 이건 네 돈이야. 시장 안쪽 상점은 얼음이랑 미끼를 판다. 값은 매일 바뀌니까 눈으로 익혀 둬."
   },
   {
    "who": "나",
    "text": "…네."
   }
  ],
  "hand": false
 },
 {
  "id": "M1-06",
  "idx": 1,
  "kind": "talk",
  "giver": "okseon",
  "npc": "okseon",
  "onField": true,
  "entryOnField": true,
  "label": "정옥선에게 법 규칙을 듣는다",
  "place": "강원 속초",
  "lines": [
   {
    "who": "정옥선",
    "text": "그게 시작이다. 잡는 법보다 먼저 배울 게 그거야. 도감에 적어 둬라. 금지체장, 금어기. 모르면 물어. 아는 척이 제일 위험하다."
   },
   {
    "who": "나",
    "text": "…고맙습니다."
   }
  ],
  "hand": false
 },
 {
  "id": "M1-11",
  "idx": 1,
  "kind": "talk",
  "giver": "coop",
  "npc": "coop",
  "onField": true,
  "entryOnField": true,
  "label": "어촌계 총회에 선다",
  "place": "강원 속초",
  "lines": [
   {
    "who": "동명항 어촌계",
    "text": "어촌계원 승낙. 오늘부터 부산 위판장도 네 자리다. 이름 불렸지. 잊지 마라, 그 이름으로 하는 일은 다 계의 일이다."
   },
   {
    "who": "나",
    "text": "고맙습니다."
   }
  ],
  "hand": false
 },
 {
  "id": "M2-09",
  "idx": 1,
  "kind": "talk",
  "giver": "coop",
  "npc": "coop",
  "onField": true,
  "entryOnField": true,
  "label": "분기 총회에 선다",
  "place": "강원 속초",
  "lines": [
   {
    "who": "동명항 어촌계",
    "text": "통과다. 도현수가 반대했지. 이유는 그 애한테 들어. 계에서 격려금이다. 쓸 데 알지."
   },
   {
    "who": "나",
    "text": "…네."
   }
  ],
  "hand": false
 },
 {
  "id": "M3-01",
  "idx": 1,
  "kind": "boatTrip",
  "giver": "go_manseok",
  "npc": "go_manseok",
  "onField": false,
  "entryOnField": false,
  "label": "고래마루 승선 1회",
  "place": "강원 속초",
  "lines": [
   {
    "who": "고만석",
    "text": "…살아 돌아왔네. 토한 건 봤다. 다들 그래. 다음엔 지깅이다. 대 챙겨 와."
   },
   {
    "who": "나",
    "text": "…고맙습니다."
   }
  ],
  "hand": false
 },
 {
  "id": "M3-05",
  "idx": 1,
  "kind": "survive",
  "giver": "go_manseok",
  "npc": "go_manseok",
  "onField": false,
  "entryOnField": false,
  "label": "해무 귀항 판단",
  "place": "강원 속초",
  "lines": [
   {
    "who": "고만석",
    "text": "돌아왔지. 조황 없어도 돌아온 게 실력이야. 다른 배 소식 들었지. 그게 답이다."
   },
   {
    "who": "나",
    "text": "…네."
   }
  ],
  "hand": false
 },
 {
  "id": "M3-09",
  "idx": 1,
  "kind": "talk",
  "giver": "tak_mansu",
  "npc": "tak_mansu",
  "onField": true,
  "entryOnField": true,
  "label": "탁만수에게 새 죽간을 받는다",
  "place": "강원 속초",
  "lines": [
   {
    "who": "탁만수",
    "text": "이 대로 한동안 낚아. 네 대는 새벽이랑 내가 본다. 로드 빌딩, 이제 네가 배울 차례다. 공방 도구도 살 수 있게 말해 뒀다."
   },
   {
    "who": "나",
    "text": "고맙습니다."
   }
  ],
  "hand": false
 },
 {
  "id": "M4-02",
  "idx": 1,
  "kind": "boatTrip",
  "giver": "chae_geumja",
  "npc": "chae_geumja",
  "onField": false,
  "entryOnField": false,
  "label": "자기 배 첫 운항",
  "place": "강원 속초",
  "lines": [
   {
    "who": "채금자",
    "text": "돌아왔네요. 첫 운항. 보트 조종, 이제 스킬로 배우세요. 그리고 이건 첫 배 축하금. 연료값이에요."
   },
   {
    "who": "나",
    "text": "고맙습니다."
   }
  ],
  "hand": false
 },
 {
  "id": "M4-06",
  "idx": 2,
  "kind": "boatTrip",
  "giver": "coop",
  "npc": "coop",
  "onField": true,
  "entryOnField": true,
  "label": "첫 손님 승선 출조",
  "place": "강원 속초",
  "lines": [
   {
    "who": "동명항 어촌계",
    "text": "돌아왔군. 손님이 또 온대? 그게 영업이다. 이 릴은 선장용이야. 손님 것보다 먼저 감겨야 하니까."
   },
   {
    "who": "나",
    "text": "…네."
   }
  ],
  "hand": false
 },
 {
  "id": "M4-11",
  "idx": 1,
  "kind": "boatTrip",
  "giver": "kang_ducheol",
  "npc": "kang_ducheol",
  "onField": true,
  "entryOnField": true,
  "label": "두 노인을 태우고 속초 앞바다 출조",
  "place": "강원 속초",
  "lines": [
   {
    "who": "혼잣말",
    "text": "동해안을 따라 하루 반. 부두에 강두철 조합장과 탁만수 노인이 서 있었다."
   },
   {
    "who": "강두철",
    "text": "첫 손님이 우리라 미안하군. 값은 정가로 받게. 봐주지 말고."
   },
   {
    "who": "탁만수",
    "text": "…키 잡은 손이 제법이다."
   },
   {
    "who": "혼잣말",
    "text": "두 사람은 나란히 앉아 아무 말 없이 바다를 봤다. 둘 다 한 마리씩 올렸다."
   },
   {
    "who": "강두철",
    "text": "…좋은 배야. 탁 씨도 그러네."
   },
   {
    "who": "혼잣말",
    "text": "누구의 배도 아닌 내 배에서."
   }
  ],
  "hand": true
 },
 {
  "id": "M4-10",
  "idx": 1,
  "kind": "talk",
  "giver": "hyeonsu",
  "npc": "hyeonsu",
  "onField": true,
  "entryOnField": true,
  "label": "도현수와 함께 출항 준비",
  "place": "강원 속초",
  "lines": [
   {
    "who": "도현수",
    "text": "…됐다. 출항이야. 제주에서 보자. 아니, 같이 가는 거지."
   },
   {
    "who": "나",
    "text": "…네."
   }
  ],
  "hand": false
 },
 {
  "id": "M5-05",
  "idx": 1,
  "kind": "talk",
  "giver": "yu_ria",
  "npc": "yu_ria",
  "onField": false,
  "entryOnField": false,
  "label": "찬성 측 취재",
  "place": "강원 속초",
  "lines": [
   {
    "who": "유리아",
    "text": "설명회 취재해 줘요. 찬성, 반대 둘 다. 어느 쪽 편도 들지 말고. 그게 제일 어려워요."
   },
   {
    "who": "나",
    "text": "…알겠습니다."
   }
  ],
  "hand": false
 },
 {
  "id": "M5-05",
  "idx": 2,
  "kind": "talk",
  "giver": "yu_ria",
  "npc": "coop",
  "onField": true,
  "entryOnField": true,
  "label": "반대 측 취재",
  "place": "강원 속초",
  "lines": [
   {
    "who": "혼잣말",
    "text": "유리아가 찬반 양측을 취재해 달라고 했다."
   },
   {
    "who": "동명항 어촌계",
    "text": "…"
   },
   {
    "who": "혼잣말",
    "text": "한물간 케이블 MC지만 사람 말을 끌어내는 솜씨는 남아 있다."
   }
  ],
  "hand": false
 },
 {
  "id": "M5-09",
  "idx": 1,
  "kind": "talk",
  "giver": "coop",
  "npc": "coop",
  "onField": true,
  "entryOnField": true,
  "label": "총회 표결에 참석",
  "place": "강원 속초",
  "lines": [
   {
    "who": "동명항 어촌계",
    "text": "표결 끝. 도현수가 같은 쪽이었지. 그거 봤나. 울릉·인천 열렸다. 그리고 병원부터 가 봐."
   },
   {
    "who": "나",
    "text": "…네."
   }
  ],
  "hand": false
 },
 {
  "id": "M6-01",
  "idx": 1,
  "kind": "survive",
  "giver": "oh_sera",
  "npc": "oh_sera",
  "onField": false,
  "entryOnField": false,
  "label": "결항 하룻밤 체류",
  "place": "강원 속초",
  "lines": [
   {
    "who": "오세라",
    "text": "살았네요. 결항 하룻밤. 섬은 원래 이래요. 이제 울릉 사람 반은 됐어요."
   },
   {
    "who": "나",
    "text": "…고맙습니다."
   }
  ],
  "hand": false
 },
 {
  "id": "M6-03",
  "idx": 1,
  "kind": "talk",
  "giver": "seok_daeyang",
  "npc": "seok_daeyang",
  "onField": false,
  "entryOnField": false,
  "label": "등대지기와 대화",
  "place": "강원 속초",
  "lines": [
   {
    "who": "석대양",
    "text": "…22년 전 그 배, 여기 앞을 지났어. 내가 봤지. 이 랜턴은 등대 것이야. 자네 아버지도 이 빛을 봤을 거야."
   },
   {
    "who": "나",
    "text": "고맙습니다."
   }
  ],
  "hand": false
 },
 {
  "id": "M6-05",
  "idx": 1,
  "kind": "talk",
  "giver": "okseon",
  "npc": "okseon",
  "onField": true,
  "entryOnField": true,
  "label": "병실의 정옥선을 찾아간다",
  "place": "강원 속초",
  "lines": [
   {
    "who": "혼잣말",
    "text": "간병 일정이 출조를 밀어낸다. 보호자 서명, 약 시간, 그리고 병원비."
   },
   {
    "who": "정옥선",
    "text": "…왔구나. 앉아. 베개 밑에 있다."
   },
   {
    "who": "정옥선",
    "text": "조행록. 마지막 권. 네 아버지 거야. 나머지는 네가 써."
   },
   {
    "who": "나",
    "text": "…나머지는 제가 쓰겠습니다."
   },
   {
    "who": "혼잣말",
    "text": "손이 떨렸다. 그 손도 내 손도."
   }
  ],
  "hand": true
 },
 {
  "id": "M6-09",
  "idx": 1,
  "kind": "boatTrip",
  "giver": "go_manseok",
  "npc": "go_manseok",
  "onField": false,
  "entryOnField": false,
  "label": "고래마루 마지막 출항에 승선",
  "place": "강원 속초",
  "lines": [
   {
    "who": "고만석",
    "text": "…끝났다. 고래마루. 해나가 몰았지. 나는 손님이었고. 자네도."
   },
   {
    "who": "나",
    "text": "고맙습니다."
   }
  ],
  "hand": false
 },
 {
  "id": "M7-04",
  "idx": 1,
  "kind": "talk",
  "giver": "okseon",
  "npc": "okseon",
  "onField": true,
  "entryOnField": true,
  "label": "정옥선과 사진을 본다",
  "place": "강원 속초",
  "lines": [
   {
    "who": "정옥선",
    "text": "사진 가져와 봐. 그 사진."
   },
   {
    "who": "혼잣말",
    "text": "가방 안쪽에서 아버지의 상자에 있던 사진을 꺼낸다."
   },
   {
    "who": "혼잣말",
    "text": "네 살의 내가 부모님 사이에 서 있다. 뒤로 빨간 줄무늬 천막이 보인다."
   },
   {
    "who": "혼잣말",
    "text": "천막 아래, 머릿수건을 쓴 사람이 상자를 고르다 고개를 들고 있다."
   },
   {
    "who": "정옥선",
    "text": "…그 천막, 내 거다."
   },
   {
    "who": "정옥선",
    "text": "22년 전. 네가 거기 서 있었어. 저 손 잡고."
   },
   {
    "who": "정옥선",
    "text": "울 거면 얼음부터 나르고 울라고 했지. 그 말이 왜 그렇게 빨리 나왔는지, 이제 알겠냐."
   },
   {
    "who": "혼잣말",
    "text": "정옥선 씨가 나를 처음 본 날이 22년 전이었다. 나는 몰랐고, 정옥선 씨는 알았다."
   }
  ],
  "hand": true
 },
 {
  "id": "M7-06",
  "idx": 1,
  "kind": "talk",
  "giver": "okseon",
  "npc": "okseon",
  "onField": true,
  "entryOnField": true,
  "label": "재개관식에 참석",
  "place": "강원 속초",
  "lines": [
   {
    "who": "정옥선",
    "text": "…잘랐지. 봤지. 이제 이 방은 네 거다. 아니, 다들 거다. 나는 좌판으로 간다."
   },
   {
    "who": "나",
    "text": "…고맙습니다."
   }
  ],
  "hand": false
 },
 {
  "id": "N01-1",
  "idx": 1,
  "kind": "talk",
  "giver": "baram",
  "npc": "baram",
  "onField": true,
  "entryOnField": true,
  "label": "바람에게 리어카 도면을 받는다",
  "place": "강원 속초",
  "lines": [
   {
    "who": "바람",
    "text": "됐네. 할머니 얼굴 봤어? 그거면 됐어. 도면은 여기. 리어카는 짐이 아니라 다리다."
   },
   {
    "who": "나",
    "text": "고맙습니다."
   }
  ],
  "hand": false
 },
 {
  "id": "N01-2",
  "idx": 1,
  "kind": "talk",
  "giver": "baram",
  "npc": "baram",
  "onField": true,
  "entryOnField": true,
  "label": "다리 밑 소년을 만난다",
  "place": "강원 속초",
  "lines": [
   {
    "who": "바람",
    "text": "전화했어. 그거면 됐어. 애들은 물고기 한 마리에 마음이 풀리더라."
   },
   {
    "who": "나",
    "text": "…고맙습니다."
   }
  ],
  "hand": false
 },
 {
  "id": "N01-3",
  "idx": 1,
  "kind": "talk",
  "giver": "baram",
  "npc": "baram",
  "onField": true,
  "entryOnField": true,
  "label": "덕장 주인과 대화",
  "place": "강원 속초",
  "lines": [
   {
    "who": "바람",
    "text": "대를 안 비운대. 그거면 됐어. 바다가 바뀌면 사람이 바뀌는 거야."
   },
   {
    "who": "나",
    "text": "…네."
   }
  ],
  "hand": false
 },
 {
  "id": "N01-5",
  "idx": 0,
  "kind": "talk",
  "giver": "baram",
  "npc": "kang_haesol",
  "onField": false,
  "entryOnField": true,
  "label": "해녀의 딸, 해솔에게 말을 건다",
  "place": "강원 속초",
  "lines": [
   {
    "who": "혼잣말",
    "text": "서귀포 항구에서 바람 씨를 다시 만났다."
   },
   {
