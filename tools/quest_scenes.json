  "lines": [
   {
    "who": "하늬",
    "text": "인천 폐채석장에 뭐가 남았대요. 가 보세요. 캔 건 나눠요. 반반."
   },
   {
    "who": "나",
    "text": "해 보겠습니다."
   }
  ],
  "hand": false
 },
 {
