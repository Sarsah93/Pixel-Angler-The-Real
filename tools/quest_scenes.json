  "place": "강원 속초",
  "lines": [
   {
    "who": "혼잣말",
    "text": "어촌계 게시판에 안건이 붙었다."
   },
   {
    "who": "문필구",
    "text": "…"
   },
   {
    "who": "혼잣말",
    "text": "「동명항 찌 가게 간판 문구 건」."
   }
  ],
  "hand": false
 },
 {
